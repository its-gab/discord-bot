# This is an example .env file for the Discord bot.
# Please copy this file to .env and fill in your Discord bot token.

DISCORD_TOKEN=123456789012345678
OWNER_ID=123456789012345678
STEAM_ID=123456789012345678

SENSOR_API_URL=http://host.docker.internal:8765/sensor

# Channels
ADMIN_COMMANDS_CHANNEL_ID=123456789012345678
COMMANDS_CHANNEL_ID=123456789012345678
WELCOME_CHANNEL_ID=123456789012345678
MINECRAFT_COMMANDS_CHANNEL_ID=123456789012345678
STEAM_WISHLIST_CHANNEL_ID=123456789012345678

# Paths
MC_DATA_PATH=/path/to/minecraft/data